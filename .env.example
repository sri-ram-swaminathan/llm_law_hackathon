# Required for live runs (Start demo, Re-run, Add document). Without it the app still serves the recorded runs.
MISTRAL_API_KEY=
CCO_MODEL_EVAL=codestral-latest
CCO_MODEL_LIGHT=ministral-8b-latest
CCO_MODEL_EMBED=mistral-embed

LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=
LEGIFRANCE_OAUTH_URL=https://oauth.piste.gouv.fr/api/oauth/token
LEGIFRANCE_API_URL=https://api.piste.gouv.fr/dila/legifrance/lf-engine-app

# Optional: lets the app's "Run on GitHub" button re-run the release PR check on RomanGrebnev/FinTechProto.
# Needs a token with Actions write access to that repo (collaborators only).
GITHUB_TOKEN=
# Optional: deploy token the web app asks for once (default dev-token).
# CCO_DEPLOY_TOKEN=dev-token
