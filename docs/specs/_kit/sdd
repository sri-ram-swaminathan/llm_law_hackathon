def cmd_version(args) -> int:
    print(VERSION)
    return 0


def _version_tuple(v: str) -> tuple[int, ...]:
    return tuple(int(x) for x in re.findall(r"\d+", v)[:3])


def cmd_install(args) -> int:
    repo = Path(args.repo).resolve()
    specs = repo / "docs" / "specs"
    kit = specs / "_kit"
    current = (kit / "VERSION").read_text().strip() if (kit / "VERSION").exists() else None
    if current and _version_tuple(current) >= _version_tuple(VERSION) and not args.force:
        print(f"kit {current} already installed in {kit}")
        return 0
    kit.mkdir(parents=True, exist_ok=True)
    for item in KIT_DIR.iterdir():
        if item.name in ("tests", "__pycache__", ".pytest_cache") or item.name.startswith("."):
            continue
        target = kit / item.name
        if item.is_dir():
            if target.exists():
                shutil.rmtree(target)
            shutil.copytree(item, target, ignore=shutil.ignore_patterns("__pycache__"))
        else:
            shutil.copy2(item, target)
    shutil.copy2(KIT_DIR / "README.md", specs / "README.md")
    (kit / "sdd").chmod(0o755)
    print(f"kit {VERSION} installed in {kit}" + (f" (was {current})" if current else ""))
    return 0


def _template(name: str) -> Template:
    path = KIT_DIR / "templates" / f"{name}.md"
    if not path.exists():
        raise SddError(f"template {name}.md not found in {path.parent}")
    return Template(path.read_text())


def cmd_new(args) -> int:
    specs = find_specs_dir(args.specs)
    if not SLUG_RE.match(args.slug):
        raise SddError("slug must be lowercase letters, digits and hyphens")
    for p in work_folders(specs):
        if FOLDER_RE.match(p.name).group(2) == args.slug:
            raise SddError(f"slug {args.slug!r} already used by {p.name}")
    date = args.date or dt.date.today().isoformat()
    folder = specs / f"{date}-{args.slug}"
    folder.mkdir(parents=True)
    values = {"slug": args.slug, "title": args.title or args.slug.replace("-", " ").capitalize(),
              "date": date, "base": args.base, "size": args.size}
    spec_text = _quote_header_value(_template("SPEC").safe_substitute(values), "title", values["title"])
    (folder / "SPEC.md").write_text(spec_text)
    (folder / "PREFLIGHT.md").write_text(_template("PREFLIGHT").safe_substitute(values))
    (folder / "LOG.md").write_text(f"# Log — {args.slug}\n\n")
    Folder(folder).log("spec", f"folder created (base: {values['base']}, size: {args.size})")
    print(folder)
