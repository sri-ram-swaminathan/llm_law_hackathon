def _node(tid: str) -> str:
    return re.sub(r"[^A-Za-z0-9_]", "_", tid)


def cmd_graph(args) -> int:
    folder = resolve_folder(find_specs_dir(args.specs), args.folder)
    tasks = folder.tasks()
    lines = ["graph TD"]
    for t in tasks:
        label = f"{t.id} · {t.title}".replace('"', "'")
        shape = {"work": f'["{label}"]', "verify": f'(["{label}"])', "gate": f'{{{{"{label}"}}}}'}.get(t.kind, f'["{label}"]')
        cls = f":::{t.status}" if t.status in ("done", "doing", "blocked") else ""
        lines.append(f"  {_node(t.id)}{shape}{cls}")
    for t in tasks:
        for d in t.deps:
            lines.append(f"  {_node(d)} --> {_node(t.id)}")
    lines += ["  classDef done fill:#d3f9d8,stroke:#2b8a3e", "  classDef doing fill:#fff3bf,stroke:#e67700",
              "  classDef blocked fill:#ffe3e3,stroke:#c92a2a"]
    print("\n".join(lines))
    return 0


