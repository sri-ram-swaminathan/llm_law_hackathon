    errors, warnings = check_folder(folder)
    if args.json:
        print(json.dumps({"folder": str(folder.path), "errors": errors, "warnings": warnings}, indent=2))
    else:
        for e in errors:
            print(f"error: {e}")
        for w in warnings:
            print(f"warning: {w}")
        print(f"{folder.path.name}: {len(errors)} error(s), {len(warnings)} warning(s)")
    return 1 if errors else 0


def cmd_status(args) -> int:
