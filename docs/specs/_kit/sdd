    print(f"{data['slug']} — {data['title']}  [{data['spec_status']} · mode {data['run_mode']} · "
          f"{data['base_branch']} ← {data['integration_branch']}]")
    by_wave: dict[int, list[dict]] = {}
    for t in data["tasks"]:
        by_wave.setdefault(t["wave"], []).append(t)
