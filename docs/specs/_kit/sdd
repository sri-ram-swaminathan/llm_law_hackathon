VERSION = "0.2.2"
KIT_DIR = Path(__file__).resolve().parent
PROTECTED_BRANCHES = {"main", "master", "dev", "develop", "staging", "production", "prod"}
SPEC_STATUSES = ["draft", "approved", "planned", "executing", "verifying", "closed"]
TASK_STATUSES = ["todo", "doing", "review", "done", "blocked", "skipped"]
KINDS = ["work", "verify", "gate"]
# none: merged on its verify command alone. light: one review, blocking only on bugs in the task's own files.
REVIEWS = ["none", "light"]
REQUIRED_SETTINGS = ["title", "slug", "created", "status", "size", "base_branch",
                     "integration_branch", "task_branch_pattern", "repos", "run_mode", "push"]
FOLDER_RE = re.compile(r"^(\d{4}-\d{2}-\d{2})-([a-z0-9][a-z0-9-]*)$")
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
ID_RE = re.compile(r"^[A-Za-z][A-Za-z0-9._-]*$")
LOG_RE = re.compile(r"^- (\d{4}-\d{2}-\d{2} \d{2}:\d{2}) · ([^·]+?) · (.*)$")
SECRET_NAME_RE = re.compile(r"(KEY|TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL)", re.I)
MIN_FREE_DISK = 5 * 1024 ** 3
MIN_FREE_MEM = 2 * 1024 ** 3


class SddError(Exception):
    """A user-facing error: printed without a traceback, exit code 1 unless given."""

    def __init__(self, message: str, code: int = 1):
        super().__init__(message)
        self.code = code


# ---------------------------------------------------------------- frontmatter

def _opens_quote(text: str, i: int) -> bool:
    # A quote starts a quoted run only at the start of a word and only if it is closed later,
    # so apostrophes inside words ("Roman's", "what's-new.md") stay literal.
    ch = text[i]
    return ch in "\"'" and (i == 0 or not text[i - 1].isalnum()) and ch in text[i + 1:]


def _strip_comment(value: str) -> str:
    quote = None
    for i, ch in enumerate(value):
        if quote:
            if ch == quote:
                quote = None
        elif _opens_quote(value, i):
            quote = ch
        elif ch == "#" and (i == 0 or value[i - 1].isspace()):
            return value[:i]
    return value


def _unquote(value: str) -> str:
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def _split_list(inner: str) -> list[str]:
    items, quote, current = [], None, ""
    for i, ch in enumerate(inner):
        if quote:
            current += ch
            if ch == quote:
                quote = None
        elif _opens_quote(inner, i):
            quote = ch
            current += ch
        elif ch == ",":
            items.append(current)
            current = ""
        else:
            current += ch
    items.append(current)
    return [_unquote(x.strip()) for x in items if x.strip()]


def parse_value(raw: str):
    value = _strip_comment(raw).strip()
    if value.startswith("[") and value.endswith("]"):
        return _split_list(value[1:-1])
    return _unquote(value)


def split_frontmatter(text: str) -> tuple[list[str], str]:
    """Return (frontmatter lines, body). Raises SddError if there is no frontmatter."""
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        raise SddError("missing frontmatter (file must start with ---)")
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            return lines[1:i], "\n".join(lines[i + 1:])
    raise SddError("unterminated frontmatter (no closing ---)")


def parse_frontmatter(text: str) -> tuple[dict, str]:
    fm_lines, body = split_frontmatter(text)
    data = {}
    for line in fm_lines:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if ":" not in line:
            raise SddError(f"bad frontmatter line: {line!r}")
        key, raw = line.split(":", 1)
        data[key.strip()] = parse_value(raw)
    return data, body


def set_frontmatter_value(text: str, key: str, value: str) -> str:
    fm_lines, body = split_frontmatter(text)
    pattern = re.compile(rf"^({re.escape(key)}:\s*)(.*?)(\s+#.*)?$")
    for i, line in enumerate(fm_lines):
        m = pattern.match(line)
        if m:
            fm_lines[i] = f"{m.group(1)}{value}{m.group(3) or ''}"
            break
    else:
        fm_lines.append(f"{key}: {value}")
    return "---\n" + "\n".join(fm_lines) + "\n---\n" + body


# ---------------------------------------------------------------- model

class Task:
    def __init__(self, path: Path, data: dict, body: str):
        self.path = path
        self.data = data
        self.body = body
        self.id = str(data.get("id", ""))
        self.title = str(data.get("title", ""))
        self.kind = str(data.get("kind", ""))
        self.deps = _as_list(data.get("deps"))
        self.owns = _as_list(data.get("owns"))
        self.needs = _as_list(data.get("needs"))
        self.repo = str(data.get("repo") or ".")
        self.verify = str(data.get("verify") or "")
        self.status = str(data.get("status", ""))
        self.review = str(data.get("review") or ("light" if self.kind == "work" else "none"))

    def dod_items(self) -> list[str]:
        section = _section(self.body, "definition of done")
        return re.findall(r"^\s*- \[[ xX]\] +(.+)$", section, re.M)

    def as_dict(self) -> dict:
        return {"id": self.id, "title": self.title, "kind": self.kind, "deps": self.deps,
                "owns": self.owns, "needs": self.needs, "repo": self.repo,
                "verify": self.verify, "status": self.status, "review": self.review, "file": str(self.path)}


def _as_list(value) -> list[str]:
    if value in (None, ""):
        return []
    if isinstance(value, list):
        return [str(v) for v in value]
    return [str(value)]


def _section(body: str, name: str) -> str:
    """Text of the first markdown section whose heading contains `name` (case-insensitive)."""
    lines = body.split("\n")
    out, inside, level = [], False, 0
    for line in lines:
        m = re.match(r"^(#{1,6})\s+(.*)$", line)
        if m:
            if inside and len(m.group(1)) <= level:
                break
            if not inside and name in m.group(2).lower():
                inside, level = True, len(m.group(1))
                continue
        if inside:
            out.append(line)
    return "\n".join(out)


class Folder:
    def __init__(self, path: Path):
        self.path = path
        spec_path = path / "SPEC.md"
        if not spec_path.exists():
            raise SddError(f"{path} has no SPEC.md")
        self.settings, self.spec_body = parse_frontmatter(spec_path.read_text())
        m = FOLDER_RE.match(path.name)
        self.slug = str(self.settings.get("slug") or (m.group(2) if m else path.name))

    @property
    def specs_dir(self) -> Path:
        return self.path.parent

    @property
    def repo_root(self) -> Path:
        return self.specs_dir.parent.parent

    def repos(self) -> list[str]:
        return _as_list(self.settings.get("repos")) or ["."]

    def repo_path(self, repo: str) -> Path:
        return (self.repo_root / repo).resolve()

    def integration_branch(self) -> str:
        return str(self.settings.get("integration_branch") or f"ft/{self.slug}")

    def task_branch(self, task_id: str) -> str:
        pattern = str(self.settings.get("task_branch_pattern") or f"ft/{self.slug}-{{id}}")
        return pattern.replace("{id}", task_id.lower()).replace("{slug}", self.slug)

    def tasks(self) -> list[Task]:
        tasks_dir = self.path / "tasks"
        if not tasks_dir.is_dir():
            return []
        result = []
        for p in sorted(tasks_dir.glob("*.md")):
            try:
                data, body = parse_frontmatter(p.read_text())
            except SddError as exc:
                raise SddError(f"{p.relative_to(self.path)}: {exc}")
            result.append(Task(p, data, body))
        return result

    def task(self, task_id: str) -> Task:
        for t in self.tasks():
            if t.id == task_id:
                return t
        raise SddError(f"no task {task_id!r} in {self.path.name}")

    def log(self, phase: str, event: str) -> str:
        line = f"- {now()} · {phase} · {event}"
        log_path = self.path / "LOG.md"
        if not log_path.exists():
            log_path.write_text(f"# Log — {self.slug}\n\n")
        # Append-only writes: parallel `sdd verify` runs log at the same time, and a
        # read-modify-write would lose lines.
        with log_path.open("a") as fh:
            fh.write(line + "\n")
        return line

    def log_entries(self) -> list[tuple[dt.datetime, str, str]]:
        log_path = self.path / "LOG.md"
        entries = []
        if log_path.exists():
            for line in log_path.read_text().split("\n"):
                m = LOG_RE.match(line.strip())
                if m:
                    stamp = dt.datetime.strptime(m.group(1), "%Y-%m-%d %H:%M")
                    entries.append((stamp, m.group(2).strip(), m.group(3).strip()))
        return entries


def now() -> str:
    return dt.datetime.now().strftime("%Y-%m-%d %H:%M")


# ---------------------------------------------------------------- locating folders

def git(args: list[str], cwd: Path, check: bool = True, timeout: int = 60) -> subprocess.CompletedProcess:
    proc = subprocess.run(["git", *args], cwd=str(cwd), capture_output=True, text=True, timeout=timeout)
    if check and proc.returncode != 0:
        raise SddError(f"git {' '.join(args)} failed in {cwd}: {proc.stderr.strip() or proc.stdout.strip()}")
    return proc


def find_specs_dir(explicit: str | None) -> Path:
    if explicit:
        return Path(explicit).resolve()
    if os.environ.get("SDD_SPECS_DIR"):
        return Path(os.environ["SDD_SPECS_DIR"]).resolve()
    if KIT_DIR.name == "_kit" and KIT_DIR.parent.name == "specs":
        return KIT_DIR.parent
    proc = git(["rev-parse", "--show-toplevel"], Path.cwd(), check=False)
    if proc.returncode != 0:
        raise SddError("not inside a git repo; pass --specs DIR")
    return Path(proc.stdout.strip()) / "docs" / "specs"


def work_folders(specs: Path) -> list[Path]:
    if not specs.is_dir():
        return []
    return sorted(p for p in specs.iterdir() if p.is_dir() and FOLDER_RE.match(p.name))


def resolve_folder(specs: Path, selector: str | None) -> Folder:
    if selector:
        candidate = Path(selector)
        if candidate.is_dir() and (candidate / "SPEC.md").exists():
            return Folder(candidate.resolve())
        for p in work_folders(specs):
            if p.name == selector or FOLDER_RE.match(p.name).group(2) == selector:
                return Folder(p)
        raise SddError(f"no work folder {selector!r} in {specs}")
    cwd = Path.cwd().resolve()
    for p in work_folders(specs):
        if cwd == p or p in cwd.parents:
            return Folder(p)
    open_folders = []
    for p in work_folders(specs):
        try:
            f = Folder(p)
        except SddError:
            continue
        if f.settings.get("status") != "closed":
            open_folders.append(f)
    if not open_folders:
        raise SddError(f"no open work folder in {specs}; create one with `sdd new <slug>`")
    return open_folders[-1]


# ---------------------------------------------------------------- graph

def compute_waves(tasks: list[Task]) -> dict[str, int]:
    """Wave = 1 + max wave of deps. Raises SddError on a cycle or unknown dep."""
    by_id = {t.id: t for t in tasks}
    waves: dict[str, int] = {}
    state: dict[str, int] = {}  # 1 = visiting, 2 = done

    def visit(tid: str, path: list[str]) -> int:
        if state.get(tid) == 2:
            return waves[tid]
        if state.get(tid) == 1:
            cycle = path[path.index(tid):] + [tid]
            raise SddError("dependency cycle: " + " → ".join(cycle))
        state[tid] = 1
        wave = 1
        for dep in by_id[tid].deps:
            if dep not in by_id:
                raise SddError(f"{tid} depends on unknown task {dep!r}")
            wave = max(wave, visit(dep, path + [tid]) + 1)
        state[tid] = 2
        waves[tid] = wave
        return wave

    for t in tasks:
        visit(t.id, [])
    return waves


def ancestors(tasks: list[Task]) -> dict[str, set[str]]:
    by_id = {t.id: t for t in tasks}
    memo: dict[str, set[str]] = {}

    def anc(tid: str) -> set[str]:
        if tid not in memo:
            result: set[str] = set()
            for dep in by_id[tid].deps:
                if dep in by_id:
                    result |= {dep} | anc(dep)
            memo[tid] = result
        return memo[tid]

    return {t.id: anc(t.id) for t in tasks}


def _has_glob(p: str) -> bool:
    return any(c in p for c in "*?[")


def _static_prefix(p: str) -> str:
    parts = []
    for part in p.split("/"):
        if _has_glob(part):
            break
        parts.append(part)
    return "/".join(parts)


def _related(a: str, b: str) -> bool:
    if not a or not b:
        return True
    return a == b or a.startswith(b + "/") or b.startswith(a + "/")


def _norm_path(p: str) -> str:
    p = p.strip()
    while p.startswith("./"):
        p = p[2:]
    return p.strip("/")


def owns_overlap(a: str, b: str) -> bool:
    """Conservative: True when two owned paths/globs could touch the same file."""
    a, b = _norm_path(a), _norm_path(b)
    if a == b:
        return True
    ga, gb = _has_glob(a), _has_glob(b)
    if not ga and not gb:
        return _related(a, b)
    if ga and not gb:
        return fnmatch.fnmatch(b, a) or _related(_static_prefix(a), b)
    if gb and not ga:
        return owns_overlap(b, a)
    return _related(_static_prefix(a), _static_prefix(b))


# ---------------------------------------------------------------- check

def check_folder(folder: Folder) -> tuple[list[str], list[str]]:
    errors: list[str] = []
    warnings: list[str] = []
    s = folder.settings
    for key in REQUIRED_SETTINGS:
        if key not in s or s[key] in ("", None):
            errors.append(f"SPEC.md: missing setting {key!r}")
    if s.get("status") and s["status"] not in SPEC_STATUSES:
        errors.append(f"SPEC.md: status {s['status']!r} not in {SPEC_STATUSES}")
    if s.get("run_mode") and s["run_mode"] not in ("step", "auto"):
        errors.append("SPEC.md: run_mode must be step or auto")
    if s.get("push") and s["push"] not in ("none", "integration", "all"):
        errors.append("SPEC.md: push must be none, integration or all")
    if s.get("size") and s["size"] not in ("lite", "full"):
        errors.append("SPEC.md: size must be lite or full")
    if str(s.get("integration_branch", "")) in PROTECTED_BRANCHES:
        errors.append("SPEC.md: integration_branch must not be a protected branch")
    if "{id}" not in str(s.get("task_branch_pattern", "{id}")):
        errors.append("SPEC.md: task_branch_pattern must contain {id}")
    body = folder.spec_body.lower()
    required_sections = ["problem", "acceptance"]
    if s.get("size") == "full":
        required_sections += ["design", "decisions"]
    for name in required_sections:
        if not re.search(rf"^#+ .*{name}", body, re.M):
            errors.append(f"SPEC.md: no section heading containing {name!r}")

    try:
        tasks = folder.tasks()
    except SddError as exc:
        return errors + [str(exc)], warnings
    if not tasks:
        warnings.append("no tasks yet (tasks/*.md)")
        return errors, warnings

    seen: dict[str, Path] = {}
    repos = folder.repos()
    for t in tasks:
        rel = t.path.relative_to(folder.path)
        for key in ("id", "title", "kind", "status"):
            if not t.data.get(key):
                errors.append(f"{rel}: missing {key!r}")
        if t.id and not ID_RE.match(t.id):
            errors.append(f"{rel}: bad id {t.id!r}")
        if t.id in seen:
            errors.append(f"{rel}: duplicate id {t.id!r} (also in {seen[t.id].name})")
        seen[t.id] = t.path
        if t.id and not t.path.name.startswith(t.id):
            warnings.append(f"{rel}: file name should start with its id {t.id!r}")
        if t.kind and t.kind not in KINDS:
            errors.append(f"{rel}: kind {t.kind!r} not in {KINDS}")
        if t.status and t.status not in TASK_STATUSES:
            errors.append(f"{rel}: status {t.status!r} not in {TASK_STATUSES}")
        if t.id in t.deps:
            errors.append(f"{rel}: depends on itself")
        if t.repo not in repos:
            errors.append(f"{rel}: repo {t.repo!r} not in settings repos {repos}")
        if t.kind in ("work", "verify"):
            if not t.verify:
                errors.append(f"{rel}: {t.kind} task needs a verify command")
            if not t.dod_items():
                errors.append(f"{rel}: needs at least one '- [ ]' item under 'Definition of done'")
        if t.kind == "work" and not t.owns:
            errors.append(f"{rel}: work task needs an owns list")
        if t.review not in REVIEWS:
            errors.append(f"{rel}: review {t.review!r} not in {REVIEWS}")
        if t.kind == "gate" and t.owns:
            warnings.append(f"{rel}: gate task owns files; gates are human decisions")
        if t.status == "done" and t.kind in ("work", "verify") and not (folder.path / "evidence" / f"{t.id}.md").exists():
            errors.append(f"{rel}: status done but evidence/{t.id}.md is missing")
        for need in t.needs:
            if need.split(":", 1)[0] not in NEED_CHECKS:
                warnings.append(f"{rel}: unknown need {need!r}")

    ids = {t.id for t in tasks}
    for t in tasks:
        for dep in t.deps:
            if dep not in ids:
                errors.append(f"{t.path.relative_to(folder.path)}: depends on unknown task {dep!r}")
    if any("unknown task" in e for e in errors):
        return errors, warnings
    try:
        compute_waves(tasks)
    except SddError as exc:
        errors.append(str(exc))
        return errors, warnings

    anc = ancestors(tasks)
    work = [t for t in tasks if t.kind == "work"]
    for i, a in enumerate(work):
        for b in work[i + 1:]:
            if a.repo != b.repo or a.id in anc[b.id] or b.id in anc[a.id]:
                continue
            for pa in a.owns:
                for pb in b.owns:
                    if owns_overlap(pa, pb):
                        errors.append(f"{a.id} and {b.id} can run in parallel but both own {pa!r}/{pb!r}; "
                                      "split the files or add a dependency")
    verifies = [t for t in tasks if t.kind == "verify"]
    for t in work:
        if not any(t.id in anc[v.id] for v in verifies):
            warnings.append(f"{t.id}: no verify task downstream (integration check)")
    if s.get("size") == "lite" and len(tasks) > 4:
        warnings.append(f"size is lite but there are {len(tasks)} tasks; consider size: full")
    return errors, warnings


# ---------------------------------------------------------------- status

def runnable(tasks: list[Task]) -> list[Task]:
    status = {t.id: t.status for t in tasks}
    return [t for t in tasks if t.status == "todo" and all(status.get(d) in ("done", "skipped") for d in t.deps)]


def elapsed_by_task(entries) -> dict[str, float]:
    started: dict[str, dt.datetime] = {}
    result: dict[str, float] = {}
    for stamp, _phase, event in entries:
        m = re.match(r"^(\S+) → (\S+)", event)
        if not m:
            continue
        tid, status = m.groups()
        if status == "doing":
            started[tid] = stamp
        elif status in ("done", "review", "blocked", "skipped") and tid in started:
            result[tid] = (stamp - started[tid]).total_seconds()
    return result


def elapsed_by_wave(entries, waves: dict[str, int]) -> dict[int, dict]:
    """First `doing` to last finish per wave; `running` until every task in it has finished."""
    starts: dict[str, dt.datetime] = {}
    ends: dict[str, dt.datetime] = {}
    for stamp, _phase, event in entries:
        m = re.match(r"^(\S+) → (\S+)", event)
        if not m or m.group(1) not in waves:
            continue
        tid, status = m.groups()
        if status == "doing":
            starts.setdefault(tid, stamp)
        elif status in ("done", "skipped"):
            ends[tid] = stamp
    result: dict[int, dict] = {}
    for wave in sorted(set(waves.values())):
        ids = [t for t, w in waves.items() if w == wave]
        began = [starts[t] for t in ids if t in starts]
        if not began:
            continue
        finished = all(t in ends for t in ids)
        last = max(ends[t] for t in ids if t in ends) if any(t in ends for t in ids) else None
        seconds = (last - min(began)).total_seconds() if finished and last else None
        result[wave] = {"seconds": seconds, "running": not finished}
    return result


def _fmt_duration(seconds: float) -> str:
    minutes = int(seconds // 60)
    return f"{minutes // 60}h{minutes % 60:02d}m"


def status_data(folder: Folder) -> dict:
    tasks = folder.tasks()
    waves = compute_waves(tasks) if tasks else {}
    entries = folder.log_entries()
    elapsed = elapsed_by_task(entries)
    ready = runnable(tasks)
    return {
        "folder": str(folder.path), "slug": folder.slug, "title": folder.settings.get("title"),
        "spec_status": folder.settings.get("status"), "run_mode": folder.settings.get("run_mode"),
        "base_branch": folder.settings.get("base_branch"), "integration_branch": folder.integration_branch(),
        "tasks": [dict(t.as_dict(), wave=waves.get(t.id), branch=folder.task_branch(t.id),
                       elapsed=elapsed.get(t.id)) for t in tasks],
        "runnable": [t.id for t in ready],
        "pending_gates": [t.id for t in ready if t.kind == "gate"],
        "done": bool(tasks) and all(t.status in ("done", "skipped") for t in tasks),
        "waves": {str(k): v for k, v in elapsed_by_wave(entries, waves).items()},
        "created": str(folder.settings.get("created")),
        "last_log": f"{entries[-1][0]:%Y-%m-%d %H:%M} · {entries[-1][1]} · {entries[-1][2]}" if entries else None,
    }


# ---------------------------------------------------------------- redaction

def secret_values(extra_names: set[str], extra_values: list[str] | None = None) -> list[str]:
    values = set(v for v in (extra_values or []) if v and len(v) >= 6)
    for key, value in os.environ.items():
        if value and len(value) >= 8 and (key in extra_names or SECRET_NAME_RE.search(key)):
            values.add(value)
    return sorted(values, key=len, reverse=True)


def redact(text: str, values: list[str]) -> str:
    for v in values:
        text = text.replace(v, "***")
    return text


# ---------------------------------------------------------------- preflight

def _run_quiet(cmd, cwd: Path | None = None, timeout: int = 30, shell: bool = False) -> tuple[int, str]:
    """Run a command; return (exit code, stdout). Output is never printed by callers
    except for fields they parse deliberately."""
    try:
        proc = subprocess.run(cmd, cwd=str(cwd) if cwd else None, capture_output=True, text=True,
                              timeout=timeout, shell=shell)
        return proc.returncode, proc.stdout
    except FileNotFoundError:
        return 127, ""
    except subprocess.TimeoutExpired:
        return 124, ""


def _env_file_value(path: Path, name: str) -> str | None:
    if not path.exists():
        return None
    for line in path.read_text(errors="replace").split("\n"):
        m = re.match(rf"^\s*(?:export\s+)?{re.escape(name)}\s*=\s*(.*)$", line)
        if m:
            return _unquote(m.group(1).strip())
    return None


def check_env(arg: str, folder: Folder, secrets: list[str]) -> tuple[str, str]:
    name, _, file_part = arg.partition("@")
    if file_part:
        value = _env_file_value(folder.repo_root / file_part, name)
        if value:
            secrets.append(value)
            return "ok", f"{name} set in {file_part} (value not shown)"
        return "missing", f"{name} not set in {file_part}"
    if os.environ.get(name):
        secrets.append(os.environ[name])
        return "ok", f"{name} set in environment (value not shown)"
    return "missing", f"{name} not set in environment"


def check_kube(arg: str, folder: Folder, secrets: list[str]) -> tuple[str, str]:
    context, _, namespace = arg.partition("/")
    if not shutil.which("kubectl"):
        return "missing", "kubectl not installed"
    code, out = _run_quiet(["kubectl", "config", "get-contexts", context, "-o", "name"])
    if code != 0 or not out.strip():
        return "missing", f"kube context {context!r} not found"
    cmd = ["kubectl", "--context", context, "auth", "can-i", "get", "pods"]
    if namespace:
        cmd += ["-n", namespace]
    code, out = _run_quiet(cmd, timeout=20)
    if out.strip() == "yes":
        return "ok", f"context {context!r}{' namespace ' + namespace if namespace else ''}: can get pods"
    return "fail", f"context {context!r}: cannot get pods (cluster unreachable or no permission)"


def _docker_config() -> dict:
    path = Path(os.environ.get("DOCKER_CONFIG", Path.home() / ".docker")) / "config.json"
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def check_registry(arg: str, folder: Folder, secrets: list[str]) -> tuple[str, str]:
    host, _, image = arg.partition("/")
    cfg = _docker_config()
    known = set(cfg.get("auths", {})) | set(cfg.get("credHelpers", {}))
    has_auth = any(host in k for k in known)
    if not has_auth and cfg.get("credsStore"):
        helper = f"docker-credential-{cfg['credsStore']}"
        code, out = _run_quiet([helper, "list"], timeout=15)
        if code == 0:
            try:
                has_auth = any(host in k for k in json.loads(out or "{}"))
            except ValueError:
                pass
    if not has_auth:
        return "missing", f"no docker login for {host}"
    if not image:
        return "ok", f"docker login present for {host}"
    code, _ = _run_quiet(["docker", "manifest", "inspect", f"{host}/{image}"], timeout=45)
    if code == 0:
        return "ok", f"can read {host}/{image}"
    return "fail", f"login present but cannot read {host}/{image}"


def check_docker(arg: str, folder: Folder, secrets: list[str]) -> tuple[str, str]:
    code, version = _run_quiet(["docker", "version", "--format", "{{.Server.Version}}"], timeout=20)
    if code != 0:
        return "missing", "docker daemon not reachable"
    # Count what `docker ps` shows; `docker info` also counts Docker Desktop's hidden containers.
    _, ids = _run_quiet(["docker", "ps", "-q"], timeout=20)
    return "ok", f"docker {version.strip()}, {len(ids.split())} containers running (not ours unless labelled)"


def check_cmd(arg: str, folder: Folder, secrets: list[str]) -> tuple[str, str]:
    return ("ok", f"{arg} on PATH") if shutil.which(arg) else ("missing", f"{arg} not on PATH")


def check_gh(arg: str, folder: Folder, secrets: list[str]) -> tuple[str, str]:
    if not shutil.which("gh"):
        return "missing", "gh not installed"
    code, _ = _run_quiet(["gh", "auth", "status"], timeout=20)
    return ("ok", "gh authenticated") if code == 0 else ("fail", "gh not authenticated")


def check_git_push(arg: str, folder: Folder, secrets: list[str]) -> tuple[str, str]:
    results = []
    worst = "ok"
    for repo in ([arg] if arg else folder.repos()):
        path = folder.repo_path(repo)
        probe = f"refs/heads/sdd-preflight-probe-{os.getpid()}"
        code, _ = _run_quiet(["git", "push", "--dry-run", "--quiet", "origin", f"HEAD:{probe}"], cwd=path, timeout=45)
        if code == 0:
            results.append(f"{repo}: can push")
        else:
            worst = "fail"
            results.append(f"{repo}: push dry-run failed")
    return worst, "; ".join(results)


def check_custom(arg: str, folder: Folder, secrets: list[str]) -> tuple[str, str]:
    code, _ = _run_quiet(_unquote(arg), cwd=folder.repo_root, timeout=60, shell=True)
    return ("ok", "exit 0") if code == 0 else ("fail", f"exit {code}")


def check_git_clean(arg: str, folder: Folder, secrets: list[str]) -> tuple[str, str]:
    dirty = []
    for repo in folder.repos():
        code, out = _run_quiet(["git", "status", "--porcelain", "--untracked-files=no"], cwd=folder.repo_path(repo))
        if code != 0:
            return "fail", f"{repo}: not a git repo"
        if out.strip():
            dirty.append(repo)
    return ("warn", f"uncommitted changes in {', '.join(dirty)}") if dirty else ("ok", "working trees clean")


def check_disk(arg: str, folder: Folder, secrets: list[str]) -> tuple[str, str]:
    free = shutil.disk_usage(folder.repo_root).free
    detail = f"{free / 1024 ** 3:.1f} GiB free"
    return ("ok", detail) if free >= MIN_FREE_DISK else ("warn", detail + " (low)")


NEED_CHECKS = {
    "env": check_env, "kube": check_kube, "registry": check_registry, "docker": check_docker,
    "cmd": check_cmd, "gh": check_gh, "git-push": check_git_push, "check": check_custom,
    "git-clean": check_git_clean, "disk": check_disk,
}
BASIC_NEEDS = ["git-clean", "gh", "docker", "disk"]


def run_preflight(folder: Folder, basic: bool) -> tuple[list[dict], list[str]]:
    needs: list[str] = list(BASIC_NEEDS)
    if not basic:
        needs += _as_list(folder.settings.get("needs"))
        for t in folder.tasks():
            needs += t.needs
    ordered = list(dict.fromkeys(needs))
    rows, secrets = [], []
    for need in ordered:
        kind, _, arg = need.partition(":")
        fn = NEED_CHECKS.get(kind)
        if not fn:
            rows.append({"need": need, "status": "fail", "detail": "unknown need type"})
            continue
        status, detail = fn(arg, folder, secrets)
        users = [t.id for t in folder.tasks() if need in t.needs] if not basic else []
        rows.append({"need": need, "status": status, "detail": detail, "tasks": users})
    return rows, secrets


def write_preflight(folder: Folder, rows: list[dict], basic: bool) -> None:
    path = folder.path / "PREFLIGHT.md"
    text = path.read_text() if path.exists() else f"# Preflight — {folder.slug}\n"
    start, end = "<!-- sdd:access:start -->", "<!-- sdd:access:end -->"
    table = [start, f"_Checked {now()} by `sdd preflight{' --basic' if basic else ''}`. Values are never shown._", "",
             "| Need | Status | Detail | Tasks |", "|---|---|---|---|"]
    for r in rows:
        table.append(f"| `{r['need']}` | {r['status']} | {r['detail']} | {', '.join(r.get('tasks') or []) or '—'} |")
    table.append(end)
    block = "\n".join(table)
    if start in text and end in text:
        text = text[:text.index(start)] + block + text[text.index(end) + len(end):]
    else:
        text = text.rstrip("\n") + "\n\n## Access and environment\n\n" + block + "\n"
    path.write_text(text)


# ---------------------------------------------------------------- resources

def _listening_ports() -> set[int]:
    ports: set[int] = set()
    code, out = _run_quiet(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN"], timeout=15)
    if code in (0, 1):
        for m in re.finditer(r":(\d+) \(LISTEN\)", out):
            ports.add(int(m.group(1)))
    return ports


def _memory() -> tuple[int | None, int | None]:
    if sys.platform == "darwin":
        code, total = _run_quiet(["sysctl", "-n", "hw.memsize"])
        code2, vm = _run_quiet(["vm_stat"])
        if code == 0 and code2 == 0:
            page = int(re.search(r"page size of (\d+)", vm).group(1)) if "page size of" in vm else 4096
            pages = sum(int(n) for n in re.findall(r"Pages (?:free|inactive|speculative):\s+(\d+)", vm))
            return int(total.strip()), pages * page
        return None, None
    try:
        info = dict(re.findall(r"^(\w+):\s+(\d+)", Path("/proc/meminfo").read_text(), re.M))
        return int(info["MemTotal"]) * 1024, int(info["MemAvailable"]) * 1024
    except (OSError, KeyError):
        return None, None


def free_ports(count: int, taken: set[int], start: int = 20000) -> list[int]:
    found: list[int] = []
    port = start
    while len(found) < count and port < 65000:
        if port not in taken:
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
                try:
                    sock.bind(("127.0.0.1", port))
                    found.append(port)
                except OSError:
                    pass
        port += 1
    return found


def resources_data(slug: str | None, ports: int) -> dict:
    containers = []
    code, out = _run_quiet(["docker", "ps", "--format", "{{json .}}"], timeout=20)
    docker_ports: set[int] = set()
    if code == 0:
        for line in out.splitlines():
            try:
                c = json.loads(line)
            except ValueError:
                continue
            # The sdd.slug label must match exactly (slug "demo" is not "demo-api"); the name is
            # only a fallback for unlabelled containers, and needs the "-" so "sdd-demo2" isn't ours.
            slug_labels = [x.strip()[len("sdd.slug="):] for x in c.get("Labels", "").split(",")
                           if x.strip().startswith("sdd.slug=")]
            name = c.get("Names", "")
            ours = bool(slug) and ((slug in slug_labels) if slug_labels
                                   else (name == f"sdd-{slug}" or name.startswith(f"sdd-{slug}-")))
            for m in re.finditer(r":(\d+)->", c.get("Ports", "")):
                docker_ports.add(int(m.group(1)))
            containers.append({"name": c.get("Names"), "image": c.get("Image"), "status": c.get("Status"),
                               "ports": c.get("Ports"), "ours": ours})
    listening = _listening_ports() | docker_ports
    total_mem, free_mem = _memory()
    disk_free = shutil.disk_usage(Path.cwd()).free
    load = os.getloadavg()[0] if hasattr(os, "getloadavg") else None
    cpus = os.cpu_count() or 1
    low = []
    if free_mem is not None and free_mem < MIN_FREE_MEM:
        low.append("memory")
    if disk_free < MIN_FREE_DISK:
        low.append("disk")
    if load is not None and load > cpus:
        low.append("cpu")
    return {
        "docker_available": code == 0, "containers": containers,
        "others_running": sum(1 for c in containers if not c["ours"]),
        "ports_in_use": sorted(listening), "cpus": cpus, "load_1m": load,
        "memory_total": total_mem, "memory_free": free_mem, "disk_free": disk_free,
        "low_headroom": low, "suggested_project": f"sdd-{slug}" if slug else None,
        "suggested_ports": free_ports(ports, listening),
    }


# ---------------------------------------------------------------- git helpers

def worktree_path(repo_path: Path, slug: str, task_id: str) -> Path:
    common = git(["rev-parse", "--git-common-dir"], repo_path).stdout.strip()
    common_path = (repo_path / common).resolve() if not os.path.isabs(common) else Path(common)
    return common_path / "sdd-worktrees" / slug / task_id


def worktrees(repo_path: Path) -> dict[str, Path]:
    """Map branch name → worktree path."""
    out = git(["worktree", "list", "--porcelain"], repo_path).stdout
    result, current = {}, None
    for line in out.splitlines():
        if line.startswith("worktree "):
            current = Path(line[len("worktree "):])
        elif line.startswith("branch refs/heads/") and current:
            result[line[len("branch refs/heads/"):]] = current
    return result


def branch_exists(repo_path: Path, branch: str) -> bool:
    return git(["show-ref", "--verify", "--quiet", f"refs/heads/{branch}"], repo_path, check=False).returncode == 0


def guard_not_protected(branch: str) -> None:
    if branch in PROTECTED_BRANCHES:
        raise SddError(f"refusing to touch protected branch {branch!r}: that needs a PR and other people's approval", 3)


