def _slugify(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:40] or "task"


def cmd_add(args) -> int:
    folder = resolve_folder(find_specs_dir(args.specs), args.folder)
    if not ID_RE.match(args.id):
        raise SddError(f"bad task id {args.id!r}")
    if any(t.id == args.id for t in folder.tasks()):
        raise SddError(f"task {args.id} already exists")
    values = {"id": args.id, "title": args.title, "kind": args.kind,
              "deps": ", ".join(_split_csv(args.deps)), "owns": ", ".join(_split_csv(args.owns)),
              "needs": ", ".join(_split_csv(args.needs)), "repo": args.repo,
              "verify": _yaml_quote(args.verify or ""),
              "review": args.review or ("light" if args.kind == "work" else "none")}
    path = folder.path / "tasks" / f"{args.id}-{_slugify(args.title)}.md"
    path.parent.mkdir(exist_ok=True)
    path.write_text(_quote_header_value(_template("TASK").safe_substitute(values), "title", args.title))
    print(path)
    return 0


def _quote_header_value(text: str, key: str, value: str) -> str:
    """Quote `key: value` in a rendered template's header when it wouldn't read back as is
    (a title like "Fix #42" would otherwise lose everything after the #)."""
    if parse_value(value) == value:
        return text
    return text.replace(f"\n{key}: {value}\n", f"\n{key}: {_yaml_quote(value)}\n", 1)


def _yaml_quote(value: str) -> str:
    if '"' not in value:
        return f'"{value}"'
    if "'" not in value:
        return f"'{value}'"
    raise SddError("a verify command can't contain both quote types; put it in a script")


def _split_csv(value: str | None) -> list[str]:
    return [v.strip() for v in (value or "").split(",") if v.strip()]


def cmd_list(args) -> int:
    specs = find_specs_dir(args.specs)
    rows = []
    for p in work_folders(specs):
        try:
            f = Folder(p)
            tasks = f.tasks()
            entries = f.log_entries()
        except SddError as exc:
            rows.append({"folder": p.name, "error": str(exc)})
            continue
        rows.append({"folder": p.name, "slug": f.slug, "title": f.settings.get("title"),
                     "status": f.settings.get("status"), "created": str(f.settings.get("created")),
                     "tasks_done": sum(1 for t in tasks if t.status in ("done", "skipped")),
                     "tasks_total": len(tasks),
                     "last": f"{entries[-1][0]:%Y-%m-%d %H:%M} {entries[-1][2]}" if entries else ""})
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        print(f"no work folders in {specs}")
    for r in rows:
        if "error" in r:
            print(f"{r['folder']}  ERROR {r['error']}")
        else:
            done = f"{r['tasks_done']}/{r['tasks_total']}"
            print(f"{r['folder']:<40} {str(r['status']):<10} {done:<6} {r['title']}  · {r['last']}")
    return 0


def cmd_check(args) -> int:
