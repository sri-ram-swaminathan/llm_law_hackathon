def cmd_verify(args) -> int:
    folder = resolve_folder(find_specs_dir(args.specs), args.folder)
    task = folder.task(args.id)
    if not task.verify:
        raise SddError(f"{task.id} has no verify command")
    repo_path = folder.repo_path(task.repo)
    if args.cwd:
        cwd = Path(args.cwd).resolve()
    elif task.kind == "work" and worktree_path(repo_path, folder.slug, task.id).exists():
        cwd = worktree_path(repo_path, folder.slug, task.id)
    else:
        cwd = worktrees(repo_path).get(folder.integration_branch(), repo_path)
    started = time.time()
    try:
        proc = subprocess.run(task.verify, shell=True, cwd=str(cwd), capture_output=True, text=True,
                              timeout=args.timeout)
        code, output = proc.returncode, (proc.stdout or "") + (proc.stderr or "")
    except subprocess.TimeoutExpired as exc:
        partial = exc.stdout or ""
        if isinstance(partial, bytes):
            partial = partial.decode(errors="replace")
        code, output = 124, f"timed out after {args.timeout}s\n{partial}"
    duration = time.time() - started
    # Redact every env need declared in the folder, including values read from `NAME@file`:
    # an integration check can print secrets that other tasks declared.
    env_needs = [n[len("env:"):] for t in folder.tasks() for n in t.needs if n.startswith("env:")]
    env_needs += [n[len("env:"):] for n in _as_list(folder.settings.get("needs")) if n.startswith("env:")]
    env_names = {n.partition("@")[0] for n in env_needs}
    file_values = [_env_file_value(folder.repo_root / f, name) for name, _, f in (n.partition("@") for n in env_needs) if f]
    output = redact(output, secret_values(env_names, [v for v in file_values if v]))
    tail = "\n".join(output.rstrip().split("\n")[-args.tail:])
    head = git(["rev-parse", "--short", "HEAD"], cwd, check=False).stdout.strip()
    branch = git(["rev-parse", "--abbrev-ref", "HEAD"], cwd, check=False).stdout.strip()
    # Verification must be of committed work: a pass on uncommitted files proves nothing about the branch.
    uncommitted = [line[3:] for line in git(["status", "--porcelain"], cwd, check=False).stdout.splitlines()
                   if not line[3:].startswith("docs/specs/")]
    if uncommitted:
        print(f"warning: uncommitted changes in {cwd}: {', '.join(uncommitted[:5])}", file=sys.stderr)
    evidence = folder.path / "evidence" / f"{task.id}.md"
    evidence.parent.mkdir(exist_ok=True)
    if not evidence.exists():
        evidence.write_text(_template("EVIDENCE").safe_substitute({"id": task.id, "title": task.title}))
    fence = "~~~~"
    section = (f"\n## Verify run — {now()}\n\n- command: `{task.verify}`\n- cwd: `{cwd}`\n"
               f"- commit: `{head}` on `{branch}`"
               + (f" — **uncommitted changes: {', '.join(uncommitted[:5])}**" if uncommitted else "")
               + f"\n- exit: **{code}** · {duration:.1f}s\n\n"
               f"{fence}text\n{tail}\n{fence}\n")
    evidence.write_text(evidence.read_text().rstrip("\n") + "\n" + section)
    folder.log("verify", f"{task.id} verify exit {code} ({duration:.0f}s)")
    print(tail)
    print(f"\n{task.id}: exit {code} · evidence/{task.id}.md")
    return 0 if code == 0 else 1


def cmd_worktree(args) -> int:
    folder = resolve_folder(find_specs_dir(args.specs), args.folder)
    task = folder.task(args.id)
    repo_path = folder.repo_path(task.repo)
    integration = folder.integration_branch()
    branch = folder.task_branch(task.id)
    guard_not_protected(integration)
    guard_not_protected(branch)
    path = worktree_path(repo_path, folder.slug, task.id)
    existing = worktrees(repo_path)
    if branch in existing:
        print(existing[branch])
        return 0
    if not branch_exists(repo_path, integration):
        raise SddError(f"integration branch {integration!r} does not exist in {repo_path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    if branch_exists(repo_path, branch):
        git(["worktree", "add", "--quiet", str(path), branch], repo_path)
    else:
        git(["worktree", "add", "--quiet", "-b", branch, str(path), integration], repo_path)
    folder.log("run", f"{task.id} worktree on {branch}")
    print(path)
    return 0


def last_verify_run(evidence: Path) -> tuple[int | None, str | None, bool]:
    """(exit, commit, uncommitted) of the most recent `sdd verify` section, or Nones."""
    if not evidence.exists():
        return None, None, False
    runs = evidence.read_text().split("\n## Verify run — ")[1:]
    if not runs:
        return None, None, False
    last = runs[-1]
    commit = re.search(r"^- commit: `([0-9a-f]*)`", last, re.M)
    code = re.search(r"^- exit: \*\*(-?\d+)\*\*", last, re.M)
    return (int(code.group(1)) if code else None, commit.group(1) if commit else None,
            "uncommitted changes" in last.split("\n- exit:")[0])


def cmd_merge(args) -> int:
    folder = resolve_folder(find_specs_dir(args.specs), args.folder)
    task = folder.task(args.id)
    status = {t.id: t.status for t in folder.tasks()}
    waiting = [d for d in task.deps if status.get(d) not in ("done", "skipped")]
    if waiting:
        raise SddError(f"{task.id} depends on {', '.join(f'{d} ({status.get(d)})' for d in waiting)}; "
                       "merge and finish dependencies first")
    repo_path = folder.repo_path(task.repo)
    integration = folder.integration_branch()
    guard_not_protected(integration)
    branch = folder.task_branch(task.id)
    if not branch_exists(repo_path, branch):
        raise SddError(f"task branch {branch!r} does not exist in {repo_path}; nothing to merge")
    tip = git(["rev-parse", branch], repo_path).stdout.strip()
    code, commit, uncommitted = last_verify_run(folder.path / "evidence" / f"{task.id}.md")
    if code != 0 or not commit or not tip.startswith(commit) or uncommitted:
        found = "no verify run" if code is None else (
            f"last verify exit {code} on `{commit}`" + (" with uncommitted changes" if uncommitted else ""))
        raise SddError(f"{task.id} is not verified at the tip of {branch} ({tip[:7]}): {found}; "
                       f"run `sdd verify {task.id}` on the committed work first")
    target = worktrees(repo_path).get(integration)
    if not target:
        raise SddError(f"{integration!r} is not checked out anywhere in {repo_path}; check it out first")
    # The orchestrator's own bookkeeping (status, log, evidence) sits uncommitted in the work
    # folder between merges; tasks never touch it, so only changes elsewhere block a merge.
    folder_rel = folder.path.resolve().relative_to(target.resolve()).as_posix() + "/" \
        if target.resolve() in folder.path.resolve().parents else None
    dirty = [line[3:] for line in git(["status", "--porcelain", "--untracked-files=no"], target).stdout.splitlines()]
    blocking = [p for p in dirty if not (folder_rel and p.startswith(folder_rel))]
    if blocking:
        raise SddError(f"{target} has uncommitted changes outside the work folder ({', '.join(blocking[:5])}); "
                       "commit them before merging")
    proc = git(["merge", "--no-ff", "-m", f"Merge {branch}: {task.title} ({task.id})", branch], target, check=False)
    if proc.returncode != 0:
        conflicts = git(["diff", "--name-only", "--diff-filter=U"], target, check=False).stdout.split()
        git(["merge", "--abort"], target, check=False)
        folder.log("run", f"{task.id} merge conflict: {', '.join(conflicts) or proc.stderr.strip()[:120]}")
        raise SddError(f"merge of {branch} conflicted ({', '.join(conflicts)}); aborted", 2)
    folder.log("run", f"{task.id} merged into {integration}")
    if args.cleanup:
        wt = worktrees(repo_path).get(branch)
        if wt:
            cwd = Path.cwd().resolve()
            if cwd == wt.resolve() or wt.resolve() in cwd.parents:
                # The merge already happened; only the cleanup is skipped.
                print(f"warning: merged, but not removing {wt}: it is the current working directory", file=sys.stderr)
                print(f"{task.id}: merged {branch} into {integration}")
                return 0
            git(["worktree", "remove", str(wt)], repo_path)
        git(["branch", "-d", branch], repo_path, check=False)
    print(f"{task.id}: merged {branch} into {integration}")
    return 0


def cmd_push(args) -> int:
    folder = resolve_folder(find_specs_dir(args.specs), args.folder)
    policy = str(folder.settings.get("push") or "none")
    if args.id:
        task = folder.task(args.id)
        repo_path, branch, kind = folder.repo_path(task.repo), folder.task_branch(task.id), "task"
    else:
        repo = args.repo or "."
        repo_path, branch, kind = folder.repo_path(repo), folder.integration_branch(), "integration"
    guard_not_protected(branch)
    if policy == "none" or (policy == "integration" and kind == "task"):
        print(f"push policy is {policy!r}: not pushing {branch}")
        return 0
    cmd = ["push", "--quiet", "-u", "origin", branch]
    if args.lease:
        if kind != "task":
            raise SddError("--lease is only allowed for task branches; the integration branch is never force-pushed")
        cmd.insert(1, "--force-with-lease")
    git(cmd, repo_path, timeout=120)
    folder.log("run", f"pushed {branch}")
    print(f"pushed {branch}")
    return 0


def cmd_preflight(args) -> int:
    folder = resolve_folder(find_specs_dir(args.specs), args.folder)
    rows, _secrets = run_preflight(folder, args.basic)
    if args.write:
        write_preflight(folder, rows, args.basic)
        problems = ", ".join(f"{r['need']}={r['status']}" for r in rows if r["status"] != "ok")
        folder.log("preflight", f"{'basic' if args.basic else 'full'}: {problems or 'all ok'}")
    if args.json:
        print(json.dumps(rows, indent=2))
    else:
        for r in rows:
            print(f"{r['status']:<8} {r['need']:<40} {r['detail']}")
    return 1 if any(r["status"] in ("missing", "fail") for r in rows) else 0


def cmd_resources(args) -> int:
    slug = args.slug
    if not slug:
        try:
            slug = resolve_folder(find_specs_dir(args.specs), args.folder).slug
        except SddError:
            slug = None
    data = resources_data(slug, args.ports)
    if args.json:
        print(json.dumps(data, indent=2))
        return 0
    gib = lambda n: f"{n / 1024 ** 3:.1f} GiB" if n is not None else "?"
    print(f"cpu {data['cpus']} cores, load {data['load_1m']:.2f}" if data["load_1m"] is not None else f"cpu {data['cpus']} cores")
    print(f"memory free {gib(data['memory_free'])} of {gib(data['memory_total'])} · disk free {gib(data['disk_free'])}")
    if data["docker_available"]:
        print(f"containers: {len(data['containers'])} running, {data['others_running']} not ours — do not touch them")
        for c in data["containers"]:
            print(f"  {'ours ' if c['ours'] else 'other'}  {c['name']:<40} {c['image']:<40} {c['ports']}")
    else:
        print("docker: not reachable")
    print(f"suggested compose project: {data['suggested_project'] or 'sdd-<slug>'} · free ports: "
          f"{', '.join(map(str, data['suggested_ports']))}")
    if data["low_headroom"]:
        print(f"LOW HEADROOM ({', '.join(data['low_headroom'])}): run heavy tasks serially")
    return 0


def cmd_settings(args) -> int:
    folder = resolve_folder(find_specs_dir(args.specs), args.folder)
    data = dict(folder.settings, folder=str(folder.path), repo_root=str(folder.repo_root))
    if args.json:
        print(json.dumps(data, indent=2, default=str))
    else:
        for k, v in data.items():
            print(f"{k}: {v}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="sdd", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--specs", help="docs/specs directory (default: next to this kit, or <git root>/docs/specs)")
    parser.add_argument("--folder", help="work folder slug or path (default: the one you're in, else the newest open one)")
    sub = parser.add_subparsers(dest="command", required=True)

    def add(name, fn, help_text):
        p = sub.add_parser(name, help=help_text)
        p.set_defaults(fn=fn)
        return p

    add("version", cmd_version, "print the kit version")
    p = add("install", cmd_install, "install or upgrade the kit into <repo>/docs/specs/_kit")
    p.add_argument("repo")
    p.add_argument("--force", action="store_true")
    p = add("new", cmd_new, "create a dated work folder")
    p.add_argument("slug")
    p.add_argument("--title")
    p.add_argument("--base", required=True, help="base branch — ask whether it is main or dev")
    p.add_argument("--size", choices=["lite", "full"], default="full")
    p.add_argument("--date", help="override the folder date (YYYY-MM-DD)")
    p = add("add", cmd_add, "add a task file from the template")
    p.add_argument("id")
    p.add_argument("title")
    p.add_argument("--kind", choices=KINDS, default="work")
    p.add_argument("--deps", help="comma-separated task ids")
    p.add_argument("--owns", help="comma-separated paths or globs")
    p.add_argument("--needs", help="comma-separated needs")
    p.add_argument("--verify", help="verify command")
    p.add_argument("--repo", default=".")
    p.add_argument("--review", choices=REVIEWS, help="work tasks default to light; none merges on verify alone")
    p = add("list", cmd_list, "list all work folders")
    p.add_argument("--json", action="store_true")
    p = add("check", cmd_check, "validate a work folder (exit 1 on errors)")
    p.add_argument("--json", action="store_true")
    p = add("status", cmd_status, "tasks by wave, next runnable, gates, timing")
    p.add_argument("--json", action="store_true")
    p = add("next", cmd_next, "runnable tasks now")
    p.add_argument("--json", action="store_true")
    add("graph", cmd_graph, "mermaid dependency graph")
    p = add("set", cmd_set, "set a task's status and log it")
    p.add_argument("id")
    p.add_argument("status")
    p.add_argument("--note")
    p.add_argument("--phase", default="run")
    p = add("spec-status", cmd_spec_status, "set SPEC.md status and log it")
    p.add_argument("status")
    p.add_argument("--note")
    p.add_argument("--phase")
    p = add("log", cmd_log, "append a timeline entry")
    p.add_argument("event")
    p.add_argument("--phase", default="note")
    p = add("verify", cmd_verify, "run a task's verify command and record evidence")
    p.add_argument("id")
    p.add_argument("--cwd")
    p.add_argument("--timeout", type=int, default=1800)
    p.add_argument("--tail", type=int, default=80)
    p = add("worktree", cmd_worktree, "create (or print) the task's worktree off the integration branch")
    p.add_argument("id")
    p = add("merge", cmd_merge, "merge a verified task branch into the integration branch (--no-ff)")
    p.add_argument("id")
    p.add_argument("--cleanup", action="store_true", help="remove the worktree and the local task branch")
    p = add("push", cmd_push, "push a task branch (id) or the integration branch, per the push policy")
    p.add_argument("id", nargs="?")
    p.add_argument("--repo")
    p.add_argument("--lease", action="store_true", help="--force-with-lease (task branches only)")
    p = add("preflight", cmd_preflight, "check access and environment; never prints secret values")
    p.add_argument("--basic", action="store_true")
    p.add_argument("--write", action="store_true", help="update PREFLIGHT.md")
    p.add_argument("--json", action="store_true")
    p = add("resources", cmd_resources, "machine headroom, containers (ours vs others), free ports")
    p.add_argument("--slug")
    p.add_argument("--ports", type=int, default=3)
    p.add_argument("--json", action="store_true")
    p = add("settings", cmd_settings, "print the SPEC settings block")
    p.add_argument("--json", action="store_true")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.fn(args)
    except SddError as exc:
        print(f"sdd: {exc}", file=sys.stderr)
        return exc.code


if __name__ == "__main__":
    sys.exit(main())
