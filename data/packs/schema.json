{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccommit.local/schemas/requirement-pack.json",
  "title": "CCOmmit requirement pack",
  "description": "Schema for data/packs/<pack>.yaml (SPEC 6.5, 6.11). The pack lists curated requirements, the provisions they derive from, and per-requirement remediation templates.",
  "type": "object",
  "required": ["id", "version", "title", "provision_refs", "requirements"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "title": {"type": "string", "minLength": 1},
    "jurisdictions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "provision_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provision_ref"}
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requirement"}
    }
  },
  "$defs": {
    "artifact_kind": {
      "enum": ["business_plan", "product_spec", "privacy_policy", "terms", "regulatory_registration", "code_repo", "other"]
    },
    "provision_ref": {
      "type": "object",
      "required": ["id", "source", "jurisdiction", "article"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "kind": {"enum": ["law", "guidance"], "default": "law"},
        "source": {"enum": ["cellar", "legifrance", "manual"]},
        "issuer": {"type": "string"},
        "jurisdiction": {"type": "string"},
        "celex": {"type": "string", "pattern": "^[0-9]{5}[A-Z][0-9]{4}(-[0-9]{8})?$|^[0-9]{5}[LR][0-9]{4}$"},
        "legi_id": {"type": ["string", "null"]},
        "article": {"type": "string"},
        "paragraph": {"type": "string"},
        "cache_file": {"type": "string", "description": "Path under data/corpus-cache/ or data/sources/"}
      }
    },
    "remediation_part": {
      "type": "object",
      "required": ["id", "kind", "title", "required_change"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^(P|A)[0-9]+$"},
        "kind": {"enum": ["code", "document", "organisational"]},
        "title": {"type": "string", "minLength": 1},
        "required_change": {"type": "string", "minLength": 1},
        "locations": {"type": "array", "items": {"type": "string"}, "description": "Globs or path:line anchors, resolved against the release"},
        "boundaries": {"type": "array", "items": {"type": "string"}, "description": "Files the part may touch"},
        "done_when": {"type": "array", "items": {"type": "string"}},
        "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^(P|A)[0-9]+$"}}
      }
    },
    "requirement": {
      "type": "object",
      "required": ["id", "domain", "title", "statement", "derived_from", "applies_when", "severity", "evidence_hints", "evidence_needed"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*-[0-9]{2}$"},
        "alias": {"type": ["string", "null"], "pattern": "^[WC][0-9]+$"},
        "domain": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "derived_from": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "applies_when": {"type": "string", "minLength": 1},
        "mandatory": {"type": "boolean", "default": false},
        "severity": {"enum": ["blocker", "high", "medium", "low"]},
        "evidence_hints": {
          "type": "object",
          "required": ["artifact_kinds", "code_globs"],
          "additionalProperties": false,
          "properties": {
            "artifact_kinds": {"type": "array", "items": {"$ref": "#/$defs/artifact_kind"}},
            "code_globs": {"type": "array", "items": {"type": "string"}}
          }
        },
        "evidence_needed": {"type": "string"},
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"parts": {"type": "array", "items": {"$ref": "#/$defs/remediation_part"}}}
        }
      }
    }
  }
}
